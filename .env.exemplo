# Credenciais da Nuvemshop — copie para .env e preencha.
# O .env esta no .gitignore: nunca comite este arquivo preenchido.

# Painel > Meus aplicativos > seu app. E o numero da loja.
NUVEMSHOP_STORE_ID=

# Token permanente gerado na autorizacao do app (nao expira).
NUVEMSHOP_ACCESS_TOKEN=

# Obrigatorio. Sem um User-Agent com email de contato a API responde 400.
NUVEMSHOP_USER_AGENT=BVBA Drop Agent (contato@bvba.com.br)

# Opcional: deixa os produtos clicaveis no relatorio. E o endereco do painel,
# que nao da para deduzir do store id.
# NUVEMSHOP_ADMIN_URL=https://sualoja.lojavirtualnuvem.com.br/admin/v2

# Opcionais — os padroes servem para loja brasileira.
# NUVEMSHOP_API_BASE=https://api.nuvemshop.com.br
# NUVEMSHOP_API_VERSION=v1
# NUVEMSHOP_IDIOMA=pt
# DROP_FUSO=America/Sao_Paulo
